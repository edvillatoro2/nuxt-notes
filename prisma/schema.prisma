generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  email     String   @unique
  createdAt DateTime @default(now())
  password  String
  updatedAt DateTime @default(now()) @updatedAt
  id        Int      @id @default(autoincrement())
  notes     Note[]
}

model Note {
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
